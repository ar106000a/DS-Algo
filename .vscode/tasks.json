{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "Compile and Run with Root Text Files",
            "command": "clang++ -std=c++17 '${file}' -o '${fileDirname}/${fileBasenameNoExtension}' && '${fileDirname}/${fileBasenameNoExtension}' < '${workspaceFolder}/input.txt' > '${workspaceFolder}/output.txt'",
            "options": {
                "cwd": "${fileDirname}",
                "shell": {
                    "executable": "/bin/zsh",
                    "args": ["-c"]
                }
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Compiles the active file and redirects I/O using input.txt and output.txt in the project root on macOS."
        }
    ]
}